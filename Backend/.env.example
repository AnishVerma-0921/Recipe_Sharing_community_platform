# Copy to .env and fill in real values

# Server
PORT=5000
NODE_ENV=development

# CORS – URL of the Vite dev server or deployed frontend
CLIENT_ORIGIN=http://localhost:5173

# Local PostgreSQL connection
DATABASE_URL=postgresql://forkful:forkful_dev_password@localhost:5432/forkful

# Replace this with a long random value before deploying
SESSION_SECRET=replace-this-with-a-long-random-secret

# Optional: create the first administrator account once
# ADMIN_NAME=Forkful Admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-unique-strong-password
